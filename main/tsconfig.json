{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "react", "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
